# Copy to .env for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# All values come from your own Supabase project (Project Settings → API).

# Browser (read at build time)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server (read at runtime)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
# Secret: never commit. Set only in Vercel / local .env.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
